{
  "name": "docsync",
  "productName": "DocSync",
  "version": "0.1.0",
  "description": "기획안·회의록을 프로젝트 docs에 항목 단위로 검토·반영하는 데스크톱 앱",
  "main": "./out/main/index.js",
  "author": "창현",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-electron-vite.mjs dev",
    "build": "electron-vite build",
    "preview": "node scripts/run-electron-vite.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:signed": "powershell -NoProfile -File ../scripts/windows/Build-SignedInstaller.ps1",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.docsync.app",
    "productName": "DocSync",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "DocSync"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "publish": null
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@google/genai": "^2.27.0",
    "@monaco-editor/react": "^4.7.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "chokidar": "^4.0.3",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "monaco-editor": "^0.52.2",
    "openai": "^7.28.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "typescript": "^5.9.0",
    "unified": "^11.0.5",
    "vite": "^7.1.0",
    "vitest": "^4.0.0",
    "zod": "^4.1.0"
  }
}
